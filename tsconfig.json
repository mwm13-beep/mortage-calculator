{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    // Important: make Vite env types available on the client
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "api",
    "src/vite-env.d.ts",
    "vite.config.*"
  ]
}
